# Container bind and published port
HOST=0.0.0.0
PORT=4173

# Demo is safe by default. Set live writes only after review.
RAIDNOW_MODE=demo
RAIDNOW_LIVE_WRITES=false

# Required for private HTTPS and Web Push deployments.
PUBLIC_ORIGIN=
RAIDNOW_COOKIE_SECURE=false

# Set all three VAPID values or leave all three empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional comma-separated exact hosts added to the built-in provider allowlist.
# Prefix the value with = to replace the built-in allowlist.
PUSH_ALLOWED_HOSTS=
